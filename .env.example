#-----------------
# NETWORK
#-----------------
BACKEND_PORT=4444
BACKEND_HEALTH_PORT=4445
FRONTEND_PORT=8888
POSTGRES_PORT=5432

#-----------------
# POSTGRES
#-----------------
POSTGRES_DB=yatg
POSTGRES_USER=yatg
POSTGRES_PASSWORD=yatg

#-----------------
# BACKEND (NestJS)
#-----------------
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

TMDB_API_URL=https://api.themoviedb.org
TMDB_API_TOKEN=tmdb_api_token

# $ node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=jwt_secret 
JWT_REFRESH_SECRET=jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_PWNED_VALIDATION_ENABLED=1
PASSWORD_PWNED_VALIDATATION_CACHE_TTL=0
PASSWORD_PWNED_MAX_CACHE_RECORDS=1000
PASSWORD_PWNED_HIBP_URL=https://api.pwnedpasswords.com

# verbose |-> debug |-> log |-> warn |-> error |-> fatal
LOG_LEVEL=verbose

#-----------------
# FRONTEND (NextJS)
#-----------------
API_URL=http://localhost:${BACKEND_PORT}
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org

#-----------------
# COMMON
#-----------------
NODE_ENV=development